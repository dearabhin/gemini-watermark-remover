{
  "name": "gemini-watermark-remover",
  "version": "2.0.0",
  "description": "Free, private, in-browser tool to remove the visible Gemini AI sparkle watermark from images and videos.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:css": "tailwindcss -i ./src/style.css -o ./public/css/output.css --minify",
    "watch:css": "tailwindcss -i ./src/style.css -o ./public/css/output.css --watch",
    "build": "npm run build:css && vite build",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dearabhin/gemini-watermark-remover.git"
  },
  "keywords": [
    "gemini",
    "watermark",
    "remover",
    "vue",
    "vite",
    "tailwind"
  ],
  "author": "Abhin Krishna",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dearabhin/gemini-watermark-remover/issues"
  },
  "homepage": "https://github.com/dearabhin/gemini-watermark-remover#readme",
  "dependencies": {
    "mediabunny": "^1.50.9",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.20",
    "tailwindcss": "^3.4.19",
    "vite": "^8.1.5"
  }
}
